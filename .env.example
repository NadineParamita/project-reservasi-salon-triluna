# =====================================================================
# .env.example - CONTOH isi file .env (aman dimasukkan ke Git)
#
# Cara pakai:
#   1. Salin file ini menjadi ".env"
#   2. Ganti nilai contoh dengan nilai asli
#   3. JANGAN PERNAH memasukkan file ".env" ke Git
#
# Nilai asli (terutama password) diminta ke pemegang peran Database
# lewat chat pribadi, bukan lewat grup.
# =====================================================================

# ---------------------------------------------------------------------
# Database (Supabase, PostgreSQL)
# Ambil di Supabase: klik tombol "Connect" di bagian atas dashboard,
# lalu pilih "Session pooler" dan salin URI-nya.
# Ganti seluruh tulisan [YOUR-PASSWORD] (termasuk kurung sikunya)
# dengan password database. Tidak boleh ada spasi.
# Jika password mengandung simbol, simbol harus di-percent-encode.
# ---------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.GANTI_PROJECT_ID:GANTI_PASSWORD@aws-0-GANTI_REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------
# Opsional - hanya jika Web Push dan worker WAJIB (menunggu kabar dosen)
# Hapus tanda # di depan baris jika sudah dipakai.
# Nama variabel boleh disesuaikan dengan kode Backend.
# Kunci PRIVAT hanya boleh ada di server, tidak boleh ke tampilan.
# ---------------------------------------------------------------------
# VAPID_PUBLIC_KEY=GANTI_DENGAN_KUNCI_PUBLIK
# VAPID_PRIVATE_KEY=GANTI_DENGAN_KUNCI_PRIVAT
# REDIS_URL=redis://GANTI_HOST:6379

# Kunci rahasia untuk tanda login. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=GANTI_DENGAN_STRING_ACAK.
